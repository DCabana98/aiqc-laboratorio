# ==============================================================
# AIQC – Plantilla de secretos
# Copia este archivo a  .streamlit/secrets.toml  y rellena tus valores.
# NUNCA subas secrets.toml al repositorio (está en .gitignore).
# En Streamlit Cloud: pega este contenido en Settings → Secrets.
# ==============================================================

# Contraseña inicial del usuario 'admin' (solo se usa al crear la BD vacía).
[auth]
admin_password = "admin"

# Ruta opcional de la base de datos SQLite. Si se omite, AIQC usa
# ~/.aiqc/aiqc_acciones.db (o /tmp/aiqc_acciones.db en algunos hosts).
[db]
path = "./.aiqc/aiqc_acciones.db"

# Asistente IA – Google Gemini. Obtén la clave en https://aistudio.google.com/apikey
[gemini]
api_key = ""

# Sincronización de datos OpenLab (Agilent) servidos como CSV en GitHub.
# El CSV debe tener columnas: Fecha, Analito, Nivel, Valor, Media_Objetivo, SD_Objetivo, Lote.
# Esta misma sección la usa el agente de subida scripts/sync_openlab.py
# (que corre en el laboratorio). Para LEER basta token si el repo es privado;
# para ESCRIBIR (el agente) el token necesita permiso de escritura (Contents).
[github]
usuario = ""                       # dueño del repo, p. ej. "mi-laboratorio"
repo    = ""                       # nombre del repo, p. ej. "datos-qc"
rama    = "main"
archivo = "data/controles_qc.csv"  # ruta del CSV dentro del repo
token   = ""                       # token de acceso (lectura; o escritura para el agente)

# Nombre del laboratorio que aparece en los informes PDF.
[lab]
nombre = "LAB. CENTRAL"
